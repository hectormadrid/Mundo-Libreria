# Servidor
NODE_ENV=development
PORT=3000
# Clave para firmar las cookies de sesión. En producción: al menos 32 caracteres aleatorios.
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Detrás de un proxy (cPanel, Nginx, Apache): número de proxies (normalmente 1). Vacío = sin proxy.
TRUST_PROXY=

# Base de datos Supabase: cadena del "Session pooler" (Dashboard → Connect → Session pooler).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Opcional: ruta al certificado raíz de Supabase para verificar el servidor (Database Settings → SSL).
DATABASE_CA_CERT=

# Supabase Storage (imágenes de productos). Sin estos datos se usa public/uploads/productos.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta (sb_secret_...): Dashboard → Settings → API Keys. Solo para el servidor.
SUPABASE_SECRET_KEY=

# URL pública de la tienda (se usa en los enlaces de los correos), p. ej. https://mundolibreria.cl
APP_URL=

# Correo saliente (si SMTP_USER queda vacío, los correos se escriben en logs/mail_debug.log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Mundo Librería
