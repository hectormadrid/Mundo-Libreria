DB_HOST=localhost
DB_NAME=tu_base_de_datos
DB_USER=root
DB_PASS=tu_contraseña
DEBUG_MODE=false

# URL pública de la tienda (se usa en los enlaces de los correos).
# Local con XAMPP: http://localhost/Mundo-Libreria/public
