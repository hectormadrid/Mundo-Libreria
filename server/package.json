{
  "name": "mundo-libreria-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "decodificar-entidades": "tsx scripts/decodificar-entidades.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-mysql-session": "3.0.3",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.1.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "3.0.8",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
