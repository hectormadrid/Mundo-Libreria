{
  "name": "mundo-libreria-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "subir-imagenes": "tsx scripts/subir-imagenes.ts",
    "exportar-mysql": "tsx scripts/exportar-mysql.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "bcryptjs": "3.0.3",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "mysql2": "3.24.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
